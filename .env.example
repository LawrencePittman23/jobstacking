# ---- NextAuth ----
# Generate a random 32+ char secret: `openssl rand -base64 32`
NEXTAUTH_SECRET=replace_with_random_32_char_string
# Your Vercel production URL (or http://localhost:3000 for local dev)
NEXTAUTH_URL=https://your-app.vercel.app

# ---- Google OAuth (from Google Cloud Console) ----
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx

# ---- Vercel Postgres (auto-set by Vercel when you create the DB) ----
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ---- Cron secret (any random string; used by Vercel cron) ----
CRON_SECRET=replace_with_random_string
