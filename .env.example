# ---- NextAuth ----
NEXTAUTH_SECRET=replace_with_random_32_char_string
NEXTAUTH_URL=https://your-app.vercel.app

# ---- Google OAuth (from Google Cloud Console) ----
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx

# ---- Vercel Postgres (auto-set when you connect Neon) ----
POSTGRES_URL=

# ---- Cron secret ----
CRON_SECRET=replace_with_random_string

# ---- Job search APIs (optional, for more jobs) ----
# Adzuna: free signup at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_API_KEY=
# RapidAPI / JSearch: free signup at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
